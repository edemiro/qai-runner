# Copy this file to .env and fill in your own values.
# QAi reads .env from THIS directory, regardless of where you start the server.

# --- Model provider -------------------------------------------------------
# QAi drives the agent on Claude (Anthropic) only. The model is also settable
# from the Settings screen; that writes it back into this file.
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-5

ANTHROPIC_API_KEY=         # https://console.anthropic.com/settings/keys
# Only needed for identity-linked keys; workspace-scoped keys can leave this empty.
ANTHROPIC_WORKSPACE_ID=

# Where the Appium server listens. Only change this if you run Appium on
# another port or host.
APPIUM_HOST=http://localhost:4723

# Hard ceiling on agent steps per run. The UI can request fewer, never more.
MAX_AGENT_STEPS=40

# Only for driving a REAL iPhone. WebDriverAgent has to be signed to run on a
# physical device, and a free Apple account cannot register the stock
# 'com.facebook.WebDriverAgentRunner' id because it belongs to someone else.
# Re-sign WDA under a unique id and put that id here. Leave empty for
# simulators and Android, which need no signing.
WDA_BUNDLE_ID=

# Browser origins allowed to call this API. A wildcard here would let any
# website you visit drive your connected phone.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
